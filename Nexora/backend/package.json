{
  "name": "nexora-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Nexora — API REST del gestionale. © Roberto Di Flumeri",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "db:push": "prisma db push --skip-generate",
    "generate": "prisma generate",
    "demo": "tsx scripts/demo.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.1",
    "@prisma/client": "5.22.0",
    "bcryptjs": "^2.4.3",
    "bwip-js": "^4.5.1",
    "fastify": "^5.2.0",
    "jose": "^5.9.6",
    "pdfkit": "^0.15.1",
    "qrcode": "^1.5.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/pdfkit": "^0.13.8",
    "@types/qrcode": "^1.5.5",
    "fast-xml-parser": "^4.5.1",
    "prisma": "5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
